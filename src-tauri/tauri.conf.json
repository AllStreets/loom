{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LOOM",
  "version": "0.1.0",
  "identifier": "com.connorevans.loom",
  "build": {
    "beforeDevCommand": "node scripts/kernel-preboot.mjs && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/genome-bundle.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LOOM",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "resources": {
      "genome": "genome"
    }
  }
}
